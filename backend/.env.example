# ValueCraft Mail API - copy to backend/.env and fill in. Never commit backend/.env.
# Generate secrets with: npm run secrets:generate

NODE_ENV=development
HOST=127.0.0.1
PORT=4600
# Public origin of the web app (https://mail.valuecraftminds.com in production).
APP_ORIGIN=http://localhost:4601
# Optional extra allowed origins, comma separated.
CORS_ORIGINS=
# Number of reverse proxies in front of the API (Nginx, or the Next.js dev proxy) = 1.
TRUST_PROXY=1
LOG_LEVEL=info

# --- PostgreSQL: either DATABASE_URL or the DB_* variables ---
DATABASE_URL=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=vcm_mail
DB_USER=vcm_mail
DB_PASSWORD=
DB_SSL=false
DB_SSL_CA_PATH=
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=15000

# --- Sessions ---
# At least 32 random characters. Used to derive CSRF tokens.
SESSION_SECRET=
SESSION_TTL_HOURS=12
SESSION_IDLE_MINUTES=60
# Defaults to true when NODE_ENV=production.
COOKIE_SECURE=
COOKIE_SAME_SITE=lax

# --- Password hashing (Argon2id) ---
ARGON2_MEMORY_KIB=65536
ARGON2_TIME_COST=3

# --- Abuse protection ---
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
API_RATE_LIMIT_PER_MINUTE=600
ACCOUNT_LOCKOUT_THRESHOLD=5
ACCOUNT_LOCKOUT_MINUTES=15

# --- Secret encryption (mailbox credentials) ---
# 32 random bytes, base64. Required in production. Keep a secure offline backup:
# losing it makes stored mailbox credentials unrecoverable.
MAILBOX_ENCRYPTION_KEY=
MAILBOX_ENCRYPTION_KEY_ID=k1

# --- Mail provider (Hostinger Email over IMAP/SMTP) ---
MAIL_PROVIDER=hostinger
# Defaults match Hostinger's documented settings; override only if needed.
IMAP_HOST=imap.hostinger.com
IMAP_PORT=993
IMAP_SECURE=true
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
MAIL_CONNECTION_TIMEOUT_MS=15000
# Comma-separated domains whose mailboxes users may connect.
MAIL_ALLOWED_DOMAINS=valuecraftminds.com
# Append a copy of sent mail to the Sent folder (set false if the server already does).
MAIL_SAVE_SENT_COPY=true
MAIL_MAX_RECIPIENTS=100
MAIL_SEND_RATE_PER_MINUTE=20
# Total attachment size per message; keep at or below your Hostinger plan limit.
MAIL_MAX_ATTACHMENT_MB=25
MAIL_MAX_ATTACHMENTS=20
# Comma-separated file extensions that cannot be attached (defaults block executables/scripts).
MAIL_BLOCKED_EXTENSIONS=
# Reserved: the Hostinger Mail API is not used (see README).
HOSTINGER_MAIL_API_BASE_URL=
HOSTINGER_MAIL_API_TOKEN=
